# Roxy Settings（about:roxy）。
# chrome://roxy/content/ の登録と about: プロトコルへの紐付けを、
# すべて自前のファイルで完結させる（上流ファイルへのパッチは不要）。

JAR_MANIFESTS += ["jar.mn"]

XPCOM_MANIFESTS += ["components.conf"]

EXTRA_JS_MODULES.roxy += [
    "AboutRoxy.sys.mjs",
]
