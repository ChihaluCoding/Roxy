# Roxy Layer のモジュール登録。
# ここに並べたファイルは resource:///modules/roxy/<name> で参照できる。
# 新しいサブモジュールを足すときは、このリストか DIRS に追記するだけでよい
# （上流ファイルへのパッチは増やさない）。

DIRS += [
    "script-engine",
]

EXTRA_JS_MODULES.roxy += [
    "RoxyLayer.sys.mjs",
]
